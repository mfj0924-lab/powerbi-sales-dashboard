	/// 矩阵的行决定实际或目标，列决定月份、季度或年度 Total。
	measure 矩阵数值 =
			SWITCH ( SELECTEDVALUE ( '参数_明细行'[行项目] ),
			    "实际", [报表明细实际值], "目标", [报表明细单一目标],
			    "及格目标", [报表明细及格目标], "必达目标", [报表明细必达目标], "挑战目标", [报表明细挑战目标] )
		displayFolder: 05_正式报表
		lineageTag: 947713e5-733c-4ec0-910e-4163fecb2db3

		formatStringDefinition = IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "#,##0" )

	/// 矩阵空实际显示横线，保留百分比和整数格式；数值计算仍用矩阵数值。
	measure 矩阵显示数值 =
			VAR _v = [矩阵数值]
			RETURN IF ( ISBLANK ( _v ), "—", FORMAT ( _v, IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "#,##0" ) ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 006c3363-4871-422e-9b30-7febb88fd9aa

	/// 趋势和矩阵逐列比较目标，严格大于或小于；等于目标不进入更高档。
	measure 报表明细颜色 =
			VAR _v = [报表明细实际值]
			VAR _higher = SELECTEDVALUE ( 'dim_指标'[达标方向] ) = "较高值更好"
			VAR _single = SELECTEDVALUE ( 'dim_指标'[目标类型] ) = "单目标"
			VAR _a = [报表明细及格目标]
			VAR _b = [报表明细必达目标]
			VAR _c = [报表明细挑战目标]
			VAR _t = [报表明细单一目标]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), "#F7F6F5",
			    _single && ISBLANK ( _t ), "#808080",
			    _single, IF ( IF ( _higher, _v > _t, _v < _t ), "#70AD47", "#DA291C" ),
			    ISBLANK ( _a ) || ISBLANK ( _b ) || ISBLANK ( _c ), "#808080",
			    IF ( _higher, _v > _c, _v < _c ), "#70AD47",
			    IF ( _higher, _v > _b, _v < _b ), "#00B0F0",
			    IF ( _higher, _v > _a, _v < _a ), "#FFB200", "#DA291C" )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 5ea91204-a924-40ce-b3e1-34d69ef6e0d4

	/// 只给实际行着达标颜色，目标行保持浅灰。
	measure 矩阵背景颜色 = IF ( SELECTEDVALUE ( '参数_明细行'[行项目] ) = "实际", [报表明细颜色], "#F7F6F5" )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 89f66980-609d-4449-adc8-7b496a82f483

	/// 有实际值的彩色单元格使用白字，其余使用深色文字。
	measure 矩阵文字颜色 = IF ( SELECTEDVALUE ( '参数_明细行'[行项目] ) = "实际" && NOT ISBLANK ( [矩阵数值] ), "#FFFFFF", "#151936" )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 8045a6b1-a21b-4e58-9282-285556c6e053

	/// 显示同比方向和百分比；颜色继续读取已核对的同比颜色。
	measure 报表同比文字 =
			VAR _v = [同比]
			RETURN IF ( ISBLANK ( _v ), "同比 —", "同比 " & IF ( _v >= 0, "↗ +", "↘ " ) & FORMAT ( _v, "0.00%" ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 13570319-8aa5-4528-b386-e8170b7f31ba

	/// 服务报表（在正式卡片中显示整数或百分比）。按设计稿去掉整数的千位分隔符，不改实际数值。
	measure 报表卡片数值 =
			VAR _v = [卡片实际值]
			RETURN IF ( ISBLANK ( _v ), "—", FORMAT ( _v, IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "0" ) ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 62c9e524-46e9-4887-ae4e-e611b68083d3

	/// 部门页按钮使用中文部门名称；退货率显示对应年度去重后的部门数量。
	measure 报表部门标记 =
			VAR _metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			RETURN SWITCH ( _metric, "退货率", "部门数量:" & FORMAT ( [考核对象数量], "0" ), "成交率", "质量部", [显示考核对象] )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: a0baf368-d599-446a-a9f6-25c66e00f8ab

	/// 历史年度值和该年度对应的考核对象一起显示，年度由已确认分析月份推导。
	measure 历史2年度显示 =
			VAR _year = YEAR ( MAX ( '参数_分析设置'[分析月份] ) ) - 2
			VAR _value = CALCULATE ( [历史年度实际值], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year )
			VAR _metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR _names = CALCULATE ( [历史考核对象名单], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year )
			VAR _count = CALCULATE ( [历史考核对象数量], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year )
			VAR _object = SWITCH ( _metric,
			    "成交率", CALCULATE ( [历史考核对象名单], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year, 'dim_考核对象'[考核对象] = "质量部" ),
			    "退货率", IF ( _count > 1, LEFT ( _names, FIND ( "、", _names & "、" ) - 1 ) & "等" & FORMAT ( _count, "0" ) & "部门", _names ),
			    CALCULATE ( [历史考核对象名单], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year ) )
			RETURN IF ( ISBLANK ( _value ), "—", FORMAT ( _value, IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "#,##0" ) ) ) & UNICHAR ( 10 ) & _object
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: d9856589-e18a-466b-bee8-0428bab980c2

	/// 历史年度值和该年度对应的考核对象一起显示，年度由已确认分析月份推导。
