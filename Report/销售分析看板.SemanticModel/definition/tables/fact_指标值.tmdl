/// 每行一条指标、对象、周期、日期、实际或目标记录。保留源行号与共享对象数量，不可默认加总比例。
table fact_指标值
	lineageTag: 73c4b948-2218-4ce2-bbb4-d47feb37e8c5

	/// 只读取一条源业务的数值。共享部门拆出的同一源记录只取一次；多条独立业务不直接加总百分比。
	measure 原始唯一值 =
			VAR OneBusiness =
			    HASONEVALUE ( 'dim_指标'[指标编号] )
			        && HASONEVALUE ( 'fact_指标值'[周期类型] )
			        && HASONEVALUE ( 'fact_指标值'[日期] )
			        && HASONEVALUE ( 'fact_指标值'[目标及实际] )
			        && DISTINCTCOUNT ( 'fact_指标值'[源记录编号] ) = 1
			RETURN IF ( OneBusiness, SELECTEDVALUE ( 'fact_指标值'[数据] ) )
		formatString: #,##0.00
		isHidden
		displayFolder: 00_计算辅助
		lineageTag: 46232506-b152-4868-b42b-66d7a05773ab

	/// 按当前指标、对象和周期取值；成交率未选择对象时默认质量部（QUA）。
	measure 基础唯一数值 =
			VAR Metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR UseDefault = Metric = "成交率" && NOT ISCROSSFILTERED ( 'dim_考核对象' )
			RETURN
			    IF ( UseDefault,
			        CALCULATE ( [原始唯一值], KEEPFILTERS ( 'dim_考核对象'[考核对象] = "质量部" ) ),
			        [原始唯一值]
			    )
		formatString: #,##0.00
		isHidden
		displayFolder: 00_计算辅助
		lineageTag: 1819ef3b-8b6d-4361-9970-7480cec4b57e

	/// 默认2025年3月；选择单一年份后仍按3月分析，选择单一月份或季度后使用对应月份。跨年或跨月多选不生成单张卡片结果。
	measure 分析日期 =
			VAR DefaultDate = MAX ( '参数_分析设置'[分析月份] )
			VAR HasDateFilter = ISCROSSFILTERED ( 'DIM_Date' )
			VAR OneYear = HASONEVALUE ( 'DIM_Date'[年份] )
			VAR SelectedYear = IF ( OneYear, SELECTEDVALUE ( 'DIM_Date'[年份] ), YEAR ( DefaultDate ) )
			VAR HasMonthFilter = ISFILTERED ( 'DIM_Date'[月份] ) || ISFILTERED ( 'DIM_Date'[月份名称] )
			    || ISFILTERED ( 'DIM_Date'[年月] ) || ISFILTERED ( 'DIM_Date'[日期] )
			VAR HasQuarterFilter = ISFILTERED ( 'DIM_Date'[季度] ) || ISFILTERED ( 'DIM_Date'[季度序号] )
			    || ISFILTERED ( 'DIM_Date'[年季度] )
			VAR SelectedMonth = IF ( HasMonthFilter, SELECTEDVALUE ( 'DIM_Date'[月份] ),
			    IF ( HasQuarterFilter, SELECTEDVALUE ( 'DIM_Date'[季度序号] ) * 3, MONTH ( DefaultDate ) ) )
			RETURN IF ( ( NOT HasDateFilter || OneYear ) && NOT ISBLANK ( SelectedMonth ),
			    DATE ( SelectedYear, SelectedMonth, 1 ) )
		formatString: yyyy-MM-dd
		displayFolder: 00_计算辅助
		lineageTag: 431670ee-9682-4a0a-90c3-ebad3bdb79db

	/// 未选择模式时为年度；年度和月度同时选择时返回空白。
	measure 当前分析周期 = SELECTEDVALUE ( '参数_分析周期'[分析周期], IF ( NOT ISFILTERED ( '参数_分析周期'[分析周期] ), "年度" ) )
		formatString: General
		displayFolder: 00_计算辅助
		lineageTag: 9731516c-7562-4de8-8eaa-7c6993b748ca

	/// 年度模式取年度记录；月度模式对季度考核指标取当季记录。
	measure 卡片周期类型 =
			VAR Mode = [当前分析周期]
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			RETURN IF ( HASONEVALUE ( 'dim_指标'[指标编号] ),
			    SWITCH ( Mode, "年度", "年度", "月度", Frequency ) )
		formatString: General
		isHidden
		displayFolder: 00_计算辅助
		lineageTag: 9407b6a5-2de5-443e-816b-85b1664d1a69

	/// 把分析月份定位到对应年度、季度或月度记录的日期。
	measure 卡片日期 =
			VAR D = [分析日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ), SWITCH ( P,
			    "年度", DATE ( YEAR ( D ), 1, 1 ),
			    "季度", DATE ( YEAR ( D ), ( QUARTER ( D ) - 1 ) * 3 + 1, 1 ),
			    "月度", D ) )
		formatString: yyyy-MM-dd
		isHidden
		displayFolder: 00_计算辅助
		lineageTag: 3d6659ac-4eb1-4f4c-9ba8-3f6b540cd3c9

	/// 按卡片模式和分析日期读取实际；不把年度、季度、月度混合相加。
	measure 卡片实际值 =
			VAR D = [卡片日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ) && NOT ISBLANK ( P ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = D, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "实际" ) )
		displayFolder: 01_卡片数值
		lineageTag: 38d7c878-b9b9-4186-aad3-2a21c3f8dbc3

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 按卡片模式和分析日期读取目标；不把年度、季度、月度混合相加。
	measure 卡片单一目标 =
			VAR D = [卡片日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ) && NOT ISBLANK ( P ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = D, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "目标" ) )
		displayFolder: 01_卡片数值
		lineageTag: 2a613a6c-7ae5-4d5b-94df-59640a7bcde2

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 按卡片模式和分析日期读取及格目标；不把年度、季度、月度混合相加。
	measure 卡片及格目标 =
			VAR D = [卡片日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ) && NOT ISBLANK ( P ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = D, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "及格目标" ) )
		displayFolder: 01_卡片数值
		lineageTag: cafdd2cf-a67b-4236-8583-2dd1657e79f1

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 按卡片模式和分析日期读取必达目标；不把年度、季度、月度混合相加。
	measure 卡片必达目标 =
			VAR D = [卡片日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ) && NOT ISBLANK ( P ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = D, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "必达目标" ) )
		displayFolder: 01_卡片数值
		lineageTag: 7f494ff6-903d-40c7-8d40-8d5b557b1831

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 按卡片模式和分析日期读取挑战目标；不把年度、季度、月度混合相加。
	measure 卡片挑战目标 =
			VAR D = [卡片日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ) && NOT ISBLANK ( P ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = D, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "挑战目标" ) )
		displayFolder: 01_卡片数值
		lineageTag: 9c2c91b0-7808-485c-a390-f9acc5cf983d

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 年度比较去年年度。月度一般比较去年同月；净利润率、成品按时销售率按需求比较去年年度。销售额年度同比另用两年同期累计。
	measure 去年比较值 =
			VAR D = [卡片日期]
			VAR Metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR Mode = [当前分析周期]
			VAR PriorAnnual = Mode = "月度" && Metric IN { "净利润率", "成品按时销售率" }
			VAR P = IF ( PriorAnnual, "年度", [卡片周期类型] )
			VAR PreviousDate = IF ( PriorAnnual, DATE ( YEAR ( D ) - 1, 1, 1 ), EDATE ( D, -12 ) )
			RETURN IF ( NOT ISBLANK ( D ),
			    CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = PreviousDate, 'fact_指标值'[周期类型] = P,
			        'fact_指标值'[目标及实际] = "实际" ) )
		displayFolder: 02_同比计算
		lineageTag: c94a81d2-83a8-4a6a-9493-bdcdf1b7b34b

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 只累加销售额月度实际；月份缺少或实际为空时返回空白，避免用不完整月份计算同比。
	measure 销售额本年累计 =
			VAR D = [分析日期]
			VAR Y = YEAR ( D ) + ( 0 )
			VAR StartDate = DATE ( Y, 1, 1 )
			VAR EndDate = DATE ( Y, MONTH ( D ), 1 )
			VAR SourceRows = CALCULATETABLE ( 'fact_指标值', REMOVEFILTERS ( 'DIM_Date' ),
			    KEEPFILTERS ( 'dim_指标'[指标] = "商品销售额(K)" ),
			    'fact_指标值'[周期类型] = "月度", 'fact_指标值'[目标及实际] = "实际",
			    'fact_指标值'[日期] >= StartDate, 'fact_指标值'[日期] <= EndDate )
			VAR Complete = COUNTROWS ( SourceRows ) = MONTH ( D )
			    && COUNTX ( SourceRows, 'fact_指标值'[数据] ) = MONTH ( D )
			RETURN IF ( NOT ISBLANK ( D ) && Complete, SUMX ( SourceRows, 'fact_指标值'[数据] ) )
		formatString: #,##0.00
		displayFolder: 02_同比计算
		lineageTag: 3afe5ea8-1326-4527-9447-385a35e3859b

	/// 只累加销售额月度实际；月份缺少或实际为空时返回空白，避免用不完整月份计算同比。
	measure 销售额去年同期累计 =
			VAR D = [分析日期]
			VAR Y = YEAR ( D ) + ( -1 )
			VAR StartDate = DATE ( Y, 1, 1 )
			VAR EndDate = DATE ( Y, MONTH ( D ), 1 )
			VAR SourceRows = CALCULATETABLE ( 'fact_指标值', REMOVEFILTERS ( 'DIM_Date' ),
			    KEEPFILTERS ( 'dim_指标'[指标] = "商品销售额(K)" ),
			    'fact_指标值'[周期类型] = "月度", 'fact_指标值'[目标及实际] = "实际",
			    'fact_指标值'[日期] >= StartDate, 'fact_指标值'[日期] <= EndDate )
			VAR Complete = COUNTROWS ( SourceRows ) = MONTH ( D )
			    && COUNTX ( SourceRows, 'fact_指标值'[数据] ) = MONTH ( D )
			RETURN IF ( NOT ISBLANK ( D ) && Complete, SUMX ( SourceRows, 'fact_指标值'[数据] ) )
		formatString: #,##0.00
		displayFolder: 02_同比计算
		lineageTag: 0597b43f-e6b6-4fd7-9011-d189b25301c7

	/// （本期－比较期）÷比较期；销售额年度按两年一月至分析月累计比较。比较期为零或任一数值为空时返回空白。
	measure 同比 =
			VAR SalesAnnual = SELECTEDVALUE ( 'dim_指标'[指标] ) = "商品销售额(K)" && [当前分析周期] = "年度"
			VAR CurrentValue = [同比本期值]
			VAR PreviousValue = [同比比较值]
			RETURN IF ( NOT ISBLANK ( CurrentValue ) && NOT ISBLANK ( PreviousValue ),
			    DIVIDE ( CurrentValue - PreviousValue, PreviousValue ) )
		formatString: 0.00%
		displayFolder: 02_同比计算
		lineageTag: a52957c8-f656-4e5c-9362-167343f203eb

	/// 用于检查（在模型层显示当前记录的目标配置）。带教已确认源数值有效，档位未按大小排列时只说明排列情况，不判定异常或交换源值。
	measure 目标检查说明 =
			VAR TargetKind = SELECTEDVALUE ( 'dim_指标'[目标类型] )
			VAR Direction = SELECTEDVALUE ( 'dim_指标'[达标方向] )
			VAR A = [卡片及格目标]
			VAR B = [卡片必达目标]
			VAR C = [卡片挑战目标]
			VAR One = [卡片单一目标]
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( [卡片实际值] ), "没有实际值或选择不唯一",
			    TargetKind = "单目标" && ISBLANK ( One ), "目标缺失",
			    TargetKind = "多目标" && ( ISBLANK ( A ) || ISBLANK ( B ) || ISBLANK ( C ) ), "目标缺失",
			    TargetKind = "多目标" && Direction = "较高值更好" && NOT ( A <= B && B <= C ), "目标档位未按大小排列（按源值保留）",
			    TargetKind = "多目标" && Direction = "较低值更好" && NOT ( A >= B && B >= C ), "目标档位未按大小排列（按源值保留）",
			    ISBLANK ( TargetKind ) || ISBLANK ( Direction ), "指标选择不唯一",
			    "正常" )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: 87751251-00d8-4f83-bc55-917644527e9e

	/// 按需求的严格大于/小于设置达标颜色，等于目标不进入更高档。缺数或选择不唯一时灰色；目标顺序异常保留提示，颜色仍按挑战、必达、及格依次判断。
	measure 实际值颜色 =
			VAR V = [卡片实际值]
			VAR Direction = SELECTEDVALUE ( 'dim_指标'[达标方向] )
			VAR Higher = Direction = "较高值更好"
			VAR TargetKind = SELECTEDVALUE ( 'dim_指标'[目标类型] )
			VAR A = [卡片及格目标]
			VAR B = [卡片必达目标]
			VAR C = [卡片挑战目标]
			VAR T = [卡片单一目标]
			RETURN SWITCH ( TRUE (),
			    [目标检查说明] IN { "没有实际值或选择不唯一", "目标缺失", "指标选择不唯一" }, "#808080",
			    TargetKind = "单目标", IF ( IF ( Higher, V > T, V < T ), "#70AD47", "#DA291C" ),
			    IF ( Higher, V > C, V < C ), "#70AD47",
			    IF ( Higher, V > B, V < B ), "#00B0F0",
			    IF ( Higher, V > A, V < A ), "#FFB200",
			    "#DA291C" )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: 34e17193-0c19-415f-81dc-5d888c363e69

	/// 服务报表（在DAX中设置同比颜色）。变化有利时为设计稿亮绿色#6ED097，不利时红色，零或空白为灰色。
	measure 同比颜色 =
			VAR V = [同比]
			VAR Lower = SELECTEDVALUE ( 'dim_指标'[达标方向] ) = "较低值更好"
			RETURN SWITCH ( TRUE (), ISBLANK ( V ) || V = 0, "#808080",
			    IF ( Lower, V < 0, V > 0 ), "#6ED097", "#DA291C" )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: 293dacae-453c-416c-b999-aa2f85556a83

	/// 用于趋势图和矩阵；月度指标读取所选月，季度指标读取所选月对应季度，不受年度/月度按钮影响。跨多个周期合计不相加。
	measure 明细实际值 =
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Q = SELECTEDVALUE ( 'DIM_Date'[季度序号] )
			RETURN IF ( NOT ISBLANK ( Frequency ),
			    IF ( Frequency = "季度" && NOT ISBLANK ( Y ) && NOT ISBLANK ( Q ),
			        CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			            'fact_指标值'[日期] = DATE ( Y, ( Q - 1 ) * 3 + 1, 1 ),
			            'fact_指标值'[周期类型] = "季度", 'fact_指标值'[目标及实际] = "实际" ),
			        CALCULATE ( [基础唯一数值], 'fact_指标值'[周期类型] = Frequency,
			            'fact_指标值'[目标及实际] = "实际" ) ) )
		displayFolder: 04_明细图表
		lineageTag: f982024b-ecdd-4c8d-9526-c18a89bd9297

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 用于趋势图和矩阵；月度指标读取所选月，季度指标读取所选月对应季度，不受年度/月度按钮影响。跨多个周期合计不相加。
	measure 明细单一目标 =
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Q = SELECTEDVALUE ( 'DIM_Date'[季度序号] )
			RETURN IF ( NOT ISBLANK ( Frequency ),
			    IF ( Frequency = "季度" && NOT ISBLANK ( Y ) && NOT ISBLANK ( Q ),
			        CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			            'fact_指标值'[日期] = DATE ( Y, ( Q - 1 ) * 3 + 1, 1 ),
			            'fact_指标值'[周期类型] = "季度", 'fact_指标值'[目标及实际] = "目标" ),
			        CALCULATE ( [基础唯一数值], 'fact_指标值'[周期类型] = Frequency,
			            'fact_指标值'[目标及实际] = "目标" ) ) )
		displayFolder: 04_明细图表
		lineageTag: 6e9aa1b3-2d1c-4697-a1b0-807670b5f570

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 用于趋势图和矩阵；月度指标读取所选月，季度指标读取所选月对应季度，不受年度/月度按钮影响。跨多个周期合计不相加。
	measure 明细及格目标 =
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Q = SELECTEDVALUE ( 'DIM_Date'[季度序号] )
			RETURN IF ( NOT ISBLANK ( Frequency ),
			    IF ( Frequency = "季度" && NOT ISBLANK ( Y ) && NOT ISBLANK ( Q ),
			        CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			            'fact_指标值'[日期] = DATE ( Y, ( Q - 1 ) * 3 + 1, 1 ),
			            'fact_指标值'[周期类型] = "季度", 'fact_指标值'[目标及实际] = "及格目标" ),
			        CALCULATE ( [基础唯一数值], 'fact_指标值'[周期类型] = Frequency,
			            'fact_指标值'[目标及实际] = "及格目标" ) ) )
		displayFolder: 04_明细图表
		lineageTag: 689c1278-6b07-4c14-92dd-cbcb63d7c452

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 用于趋势图和矩阵；月度指标读取所选月，季度指标读取所选月对应季度，不受年度/月度按钮影响。跨多个周期合计不相加。
	measure 明细必达目标 =
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Q = SELECTEDVALUE ( 'DIM_Date'[季度序号] )
			RETURN IF ( NOT ISBLANK ( Frequency ),
			    IF ( Frequency = "季度" && NOT ISBLANK ( Y ) && NOT ISBLANK ( Q ),
			        CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			            'fact_指标值'[日期] = DATE ( Y, ( Q - 1 ) * 3 + 1, 1 ),
			            'fact_指标值'[周期类型] = "季度", 'fact_指标值'[目标及实际] = "必达目标" ),
			        CALCULATE ( [基础唯一数值], 'fact_指标值'[周期类型] = Frequency,
			            'fact_指标值'[目标及实际] = "必达目标" ) ) )
		displayFolder: 04_明细图表
		lineageTag: 39a7173f-3484-4eb6-9bbc-888ab5788d1b

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 用于趋势图和矩阵；月度指标读取所选月，季度指标读取所选月对应季度，不受年度/月度按钮影响。跨多个周期合计不相加。
	measure 明细挑战目标 =
			VAR Frequency = SELECTEDVALUE ( 'dim_指标'[考核周期] )
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Q = SELECTEDVALUE ( 'DIM_Date'[季度序号] )
			RETURN IF ( NOT ISBLANK ( Frequency ),
			    IF ( Frequency = "季度" && NOT ISBLANK ( Y ) && NOT ISBLANK ( Q ),
			        CALCULATE ( [基础唯一数值], REMOVEFILTERS ( 'DIM_Date' ),
			            'fact_指标值'[日期] = DATE ( Y, ( Q - 1 ) * 3 + 1, 1 ),
			            'fact_指标值'[周期类型] = "季度", 'fact_指标值'[目标及实际] = "挑战目标" ),
			        CALCULATE ( [基础唯一数值], 'fact_指标值'[周期类型] = Frequency,
			            'fact_指标值'[目标及实际] = "挑战目标" ) ) )
		displayFolder: 04_明细图表
		lineageTag: 84fa6048-80ed-4ff1-abb6-e8babea5baa6

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

