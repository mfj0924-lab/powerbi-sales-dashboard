	/// 灰色条形补足到实际和目标较大值的1.5倍，保持条形在卡片中间范围。
	measure 条形剩余值 =
			VAR _v = [卡片实际值]
			VAR _t = [卡片单一目标]
			RETURN IF ( NOT ISBLANK ( _v ), MAX ( _v, _t ) * 1.5 - _v )
		displayFolder: 05_正式报表
		lineageTag: 3d2c3fe9-cda9-444f-9ab6-0b032dfde25b

		formatStringDefinition = IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "#,##0" )

	/// 服务报表（在退货率悬浮提示中显示中文部门名单）。名单按对应年份读取，以顿号分开。
	measure 报表提示部门名单 =
			VAR _year = SELECTEDVALUE ( 'DIM_Date'[年份], YEAR ( MAX ( '参数_分析设置'[分析月份] ) ) )
			VAR _value = CALCULATE ( [历史考核对象名单], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year )
			RETURN _value
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 4bb79615-e6fc-4b8d-b181-a108e6531e2d

	/// 历史卡片悬浮时读取该卡片年份；当前卡片悬浮时默认分析年份。名单按行列出部门。
	measure 报表提示部门数量 =
			VAR _year = SELECTEDVALUE ( 'DIM_Date'[年份], YEAR ( MAX ( '参数_分析设置'[分析月份] ) ) )
			VAR _value = CALCULATE ( [历史考核对象数量], REMOVEFILTERS ( 'DIM_Date' ), 'DIM_Date'[年份] = _year )
			RETURN _value
		formatString: 0
		displayFolder: 05_正式报表
		lineageTag: 8ff8c7cc-b317-4202-8897-088f53b74682

	/// 服务报表（在模型层准备同比百分比文字）。与黑色的“同比”标签分开显示。
	measure 报表同比数值 =
			VAR _value = [同比]
			RETURN IF ( ISBLANK ( _value ), "—", FORMAT ( _value, "+0.00%;-0.00%;0.00%" ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 567cc3c1-ade3-4276-84a8-6c894c996584

	/// 服务报表（在模型层读取所选年份的年度实际）。历史数值与部门名称分开排版。
	measure 报表历史年度数值 =
			VAR _value = [历史年度实际值]
			RETURN IF ( ISBLANK ( _value ), "—", FORMAT ( _value, IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "0" ) ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 23c9dc97-977a-4059-a510-b9f2c89a3f70

	/// 服务报表（在模型层提供历史年份的中文部门标签）。多个退货部门在小按钮中显示“部门”，完整名单通过提示显示。
	measure 报表历史部门名称 =
			VAR _metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR _names = [历史考核对象名单]
			VAR _count = [历史考核对象数量]
			RETURN IF ( _metric = "成交率", CALCULATE ( [历史考核对象名单], 'dim_考核对象'[考核对象] = "质量部" ),
			    IF ( _metric = "退货率" && _count > 1, "质量部", _names ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 907951bc-fbc6-469d-afc0-783df1e33b83

	/// 服务报表（在模型中按同比方向与好坏选择设计稿箭头原图）。图片使用原 PNG，不改源业务数值。
	measure 报表同比箭头 =
			VAR _v = [同比]
			VAR _green = [同比颜色] = "#6ED097"
			RETURN IF ( ISBLANK ( _v ) || _v = 0, BLANK (),
			    IF ( _v > 0, IF ( _green, "data:image/png;base64,", "data:image/png;base64," ),
			        IF ( _green, "data:image/png;base64,", "data:image/png;base64," ) ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 480e210e-dfd7-4603-9db9-d00b68794ac5
		dataCategory: ImageUrl

	/// 服务报表（在成交率弹出详情中显示两位小数的百分比）。数据仍读取对应部门的年度实际值。
	measure 报表部门详情数值 =
			VAR _v = [卡片实际值]
			RETURN IF ( ISBLANK ( _v ), "—", FORMAT ( _v, "0.00%" ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 580e8afc-a24b-4e34-81ec-40c4e59d25d5

	/// 服务报表（在单件商品平均利润卡片下方显示源数据的一档目标）。采用设计图目标区域，不增加源数据中没有的其他目标档位。
	measure 报表卡片目标 =
			VAR _v = [卡片单一目标]
			RETURN IF ( ISBLANK ( _v ), "—", FORMAT ( _v, IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "0" ) ) )
		formatString: General
		displayFolder: 05_正式报表
		lineageTag: 7335339d-53a9-4240-804e-8e4100b6550a

