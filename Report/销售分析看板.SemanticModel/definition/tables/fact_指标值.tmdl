	partition fact_指标值 = m
		mode: import
		queryGroup: fact
		source =
				let
				    源 = 整理_销售分析,
				    合并指标编号 = Table.NestedJoin(源, {"指标"}, dim_指标, {"指标"}, "指标维度", JoinKind.LeftOuter),
				    展开指标编号 = Table.ExpandTableColumn(合并指标编号, "指标维度", {"指标编号"}),
				    合并对象编号 = Table.NestedJoin(展开指标编号, {"考核对象"}, dim_考核对象, {"考核对象"}, "对象维度", JoinKind.LeftOuter),
				    展开对象编号 = Table.ExpandTableColumn(合并对象编号, "对象维度", {"考核对象编号"}),
				    检查合并行数与匹配 = if Table.RowCount(展开对象编号) = Table.RowCount(源) and List.NonNullCount(展开对象编号[指标编号]) = Table.RowCount(源) and List.NonNullCount(展开对象编号[考核对象编号]) = Table.RowCount(源) then 展开对象编号 else error "维度匹配失败或合并增加行数",
				    检查重复标识 = Table.Group(检查合并行数与匹配, {"CategoryKey"}, {{"记录数", each Table.RowCount(_), Int64.Type}}),
				    确认记录唯一 = if Table.RowCount(Table.SelectRows(检查重复标识, each [记录数] <> 1)) = 0 then 检查合并行数与匹配 else error "记录标识重复，请检查源数据，不自动删除",
				    选择输出列 = Table.SelectColumns(确认记录唯一, {"源记录编号", "指标编号", "考核对象编号", "指标", "考核对象", "周期类型", "日期", "年份", "季度", "月份", "年月", "目标及实际", "数据", "原始数据", "是否修正", "原始时间", "原始考核对象", "共享对象数量", "CategoryKey"}),
				    按源记录对象排序 = Table.Sort(选择输出列, {{"源记录编号", Order.Ascending}, {"考核对象编号", Order.Ascending}})
				in
				    按源记录对象排序

	annotation PBI_ResultType = Table

