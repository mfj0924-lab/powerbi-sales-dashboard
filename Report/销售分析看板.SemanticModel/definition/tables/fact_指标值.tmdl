	/// 从指定年份年度实际非空记录查找对象。计数/名单保留对象筛选；不因成交率卡片默认质量部而限制名单。
	measure 考核对象数量 =
			VAR Y = IF ( NOT ISBLANK ( [分析日期] ), YEAR ( [分析日期] ) )
			VAR Objects = CALCULATETABLE ( VALUES ( 'fact_指标值'[考核对象] ), REMOVEFILTERS ( 'DIM_Date' ),
			    'fact_指标值'[日期] = DATE ( Y, 1, 1 ), 'fact_指标值'[周期类型] = "年度",
			    'fact_指标值'[目标及实际] = "实际", NOT ISBLANK ( 'fact_指标值'[数据] ) )
			RETURN IF ( NOT ISBLANK ( Y ) && HASONEVALUE ( 'dim_指标'[指标编号] ), COUNTROWS ( Objects ) )
		formatString: #,##0
		displayFolder: 05_部门历史
		lineageTag: b8f12508-99f1-48f2-86ed-5833863d7894

	/// 从指定年份年度实际非空记录查找对象。计数/名单保留对象筛选；不因成交率卡片默认质量部而限制名单。
	measure 历史考核对象数量 =
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Objects = CALCULATETABLE ( VALUES ( 'fact_指标值'[考核对象] ), REMOVEFILTERS ( 'DIM_Date' ),
			    'fact_指标值'[日期] = DATE ( Y, 1, 1 ), 'fact_指标值'[周期类型] = "年度",
			    'fact_指标值'[目标及实际] = "实际", NOT ISBLANK ( 'fact_指标值'[数据] ) )
			RETURN IF ( NOT ISBLANK ( Y ) && HASONEVALUE ( 'dim_指标'[指标编号] ), COUNTROWS ( Objects ) )
		formatString: #,##0
		displayFolder: 05_部门历史
		lineageTag: 149c4222-f7d2-4b9c-8ae5-02e58d9e12d2

	/// 从指定年份年度实际非空记录查找对象。计数/名单保留对象筛选；不因成交率卡片默认质量部而限制名单。
	measure 考核对象名单 =
			VAR Y = IF ( NOT ISBLANK ( [分析日期] ), YEAR ( [分析日期] ) )
			VAR Objects = CALCULATETABLE ( VALUES ( 'fact_指标值'[考核对象] ), REMOVEFILTERS ( 'DIM_Date' ),
			    'fact_指标值'[日期] = DATE ( Y, 1, 1 ), 'fact_指标值'[周期类型] = "年度",
			    'fact_指标值'[目标及实际] = "实际", NOT ISBLANK ( 'fact_指标值'[数据] ) )
			RETURN IF ( NOT ISBLANK ( Y ) && HASONEVALUE ( 'dim_指标'[指标编号] ), CONCATENATEX ( Objects, 'fact_指标值'[考核对象], "、", 'fact_指标值'[考核对象], ASC ) )
		formatString: General
		displayFolder: 05_部门历史
		lineageTag: b15a4b04-7168-4f70-959f-492feedcc507

	/// 从指定年份年度实际非空记录查找对象。计数/名单保留对象筛选；不因成交率卡片默认质量部而限制名单。
	measure 历史考核对象名单 =
			VAR Y = SELECTEDVALUE ( 'DIM_Date'[年份] )
			VAR Objects = CALCULATETABLE ( VALUES ( 'fact_指标值'[考核对象] ), REMOVEFILTERS ( 'DIM_Date' ),
			    'fact_指标值'[日期] = DATE ( Y, 1, 1 ), 'fact_指标值'[周期类型] = "年度",
			    'fact_指标值'[目标及实际] = "实际", NOT ISBLANK ( 'fact_指标值'[数据] ) )
			RETURN IF ( NOT ISBLANK ( Y ) && HASONEVALUE ( 'dim_指标'[指标编号] ), CONCATENATEX ( Objects, 'fact_指标值'[考核对象], "、", 'fact_指标值'[考核对象], ASC ) )
		formatString: General
		displayFolder: 05_部门历史
		lineageTag: e983b2dd-7527-4876-bf48-7c0c3bfd428f

	/// 显示实际考核对象的中文名称；成交率未选对象时显示质量部。
	measure 显示考核对象 =
			VAR _metric = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR _object = SELECTEDVALUE ( 'dim_考核对象'[考核对象] )
			RETURN IF ( _metric = "成交率" && NOT ISCROSSFILTERED ( 'dim_考核对象' ), "质量部",
			    IF ( NOT ISBLANK ( _object ), _object, [考核对象名单] ) )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: b7169c55-c27e-4113-bf14-33d7eaad83db

	/// 显示实际读取的年度、季度或月份。
	measure 当前期间说明 =
			VAR D = [分析日期]
			VAR P = [卡片周期类型]
			RETURN IF ( NOT ISBLANK ( D ), SWITCH ( P,
			    "年度", FORMAT ( D, "yyyy年" ),
			    "季度", FORMAT ( D, "yyyy年" ) & "Q" & QUARTER ( D ),
			    "月度", FORMAT ( D, "yyyy年m月" ) ) )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: 910b44cc-eaf5-4260-be03-00a558c524ef

	/// 直接显示同比采用的比较方式，避免把例外指标误认为去年同月。
	measure 当前比较说明 =
			VAR M = SELECTEDVALUE ( 'dim_指标'[指标] )
			VAR Mode = [当前分析周期]
			RETURN SWITCH ( TRUE (),
			    M = "商品销售额(K)" && Mode = "年度", "同比比较两年一月至分析月的月度累计",
			    Mode = "月度" && M IN { "净利润率", "成品按时销售率" }, "按需求与去年年度实际比较",
			    Mode = "年度", "与去年年度实际比较",
			    Mode = "月度", "与去年相同月份或季度比较" )
		formatString: General
		displayFolder: 03_颜色与提示
		lineageTag: 1518a00e-0a3f-4af0-a488-c6443a890e82

	/// 直接显示同比公式的本期数值；销售额年度显示一月至分析月累计，其余显示当前实际。
	measure 同比本期值 =
			VAR SalesAnnual = SELECTEDVALUE ( 'dim_指标'[指标] ) = "商品销售额(K)" && [当前分析周期] = "年度"
			RETURN IF ( SalesAnnual, [销售额本年累计], [卡片实际值] )
		displayFolder: 02_同比计算
		lineageTag: 3a751dcc-12bf-403d-93ef-20594a1018ca

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 直接显示同比公式的比较数值，供用户在检查页核对比较方式。
	measure 同比比较值 =
			VAR SalesAnnual = SELECTEDVALUE ( 'dim_指标'[指标] ) = "商品销售额(K)" && [当前分析周期] = "年度"
			RETURN IF ( SalesAnnual, [销售额去年同期累计], [去年比较值] )
		displayFolder: 02_同比计算
		lineageTag: 6e8356e9-9752-4a0e-95e0-905808c132a5

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( 'dim_指标'[数值类型] ), "百分比", "0.00%", "整数", "#,##0", "#,##0.00" )

	/// 按列名选择当前分析年份的月度、季度或年度源值；只有一条独立源记录时返回数值。
	measure 报表明细实际值 =
			VAR _year = YEAR ( MAX ( '参数_分析设置'[分析月份] ) )
			VAR _period = SELECTEDVALUE ( '参数_明细列'[周期类型] )
			VAR _number = SELECTEDVALUE ( '参数_明细列'[序号] )
			VAR _month = SWITCH ( _period, "月度", _number, "季度", (_number - 1) * 3 + 1, "年度", 1 )
			RETURN IF ( NOT ISBLANK ( _period ),
			    CALCULATE ( [原始唯一值], REMOVEFILTERS ( 'DIM_Date' ),
			        'fact_指标值'[日期] = DATE ( _year, _month, 1 ),
			        'fact_指标值'[周期类型] = _period,
			        'fact_指标值'[目标及实际] = "实际" ) )
		displayFolder: 05_正式报表
		lineageTag: d0db2b19-a459-42f1-9995-af63cfcb611b

		formatStringDefinition = IF ( SELECTEDVALUE ( 'dim_指标'[数值类型] ) = "百分比", "0.0%", "#,##0" )

