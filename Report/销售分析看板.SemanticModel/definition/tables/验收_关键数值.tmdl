/// 清洗阶段的独立预期结果与实际查询对照，不参与正式业务模型；基准源SHA256:72ee2f3573f57f23c2b2cc9b8cc346e8362196de35abb43ec1b291f3d15fb7e0
table 验收_关键数值
	lineageTag: 57bea637-f794-4399-8774-537631f8a17e

	column 指标
		dataType: string
		isNullable: false
		lineageTag: 5f542508-237e-476f-b661-f4ec0768de78
		summarizeBy: none
		sourceColumn: 指标

	column 考核对象
		dataType: string
		isNullable: false
		lineageTag: 91b1992f-fb79-4f77-a001-ffecd32693dc
		summarizeBy: none
		sourceColumn: 考核对象

	column 期间
		dataType: string
		isNullable: false
		lineageTag: e072c45f-92be-4b81-b55a-1467b4952b81
		summarizeBy: none
		sourceColumn: 期间

	column 目标及实际
		dataType: string
		isNullable: false
		lineageTag: f8d1a569-f76f-4b24-8406-cc6569a6618b
		summarizeBy: none
		sourceColumn: 目标及实际

	column 源Excel原值
		dataType: string
		isNullable: false
		lineageTag: 8fa76e56-b3a6-4724-95d2-f6f8bfcc344e
		summarizeBy: none
		sourceColumn: 源Excel原值

	column 预期值
		dataType: string
		isNullable: false
		lineageTag: a29da650-e938-482d-b3d9-0bdc211e7966
		summarizeBy: none
		sourceColumn: 预期值

	column 清洗值
		dataType: string
		isNullable: false
		lineageTag: 5dea6bea-f534-4694-b3ac-8af2eb862a0e
		summarizeBy: none
		sourceColumn: 清洗值

	column 检查结果
		dataType: string
		isNullable: false
		lineageTag: 2969b231-f9a1-482a-9e27-262d8962f8ca
		summarizeBy: none
		sourceColumn: 检查结果

	column 差异条数
		dataType: int64
		isNullable: false
		lineageTag: 428673bd-8130-4841-b2e3-3e402174ee99
		summarizeBy: none
		sourceColumn: 差异条数

